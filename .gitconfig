[user]
	name = dax
	email = dax26d@gmail.com
[core]
	editor = nvim
	quotepath = false
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	required = true
	process = git-lfs filter-process
[url "https://"]
	insteadof = git://
[color]
	ui = true
[https]
	proxy = socks5://127.0.0.1:1081
[http]
	proxy = http://127.0.0.1:1081
[init]
	defaultBranch = main
[merge]
	tool = opendiff
[mergetool]
	KeepBackup = false
[diff]
	tool = opendiff

[credential]
	helper = store
[gui]
	encoding = utf-8
[i18n "commit"]
	encoding = utf-8
[i18n]
	looutputencoding = utf-8
[pull]
	rebase = true
[safe]
	directory = *
[alias]
	today = "!git log --since=\"midnight\" --numstat --pretty=\"\" --no-merges | awk \"{add+=\\$1; del+=\\$2} END {print \\\"新增:\\\", add, \\\"删除:\\\", del, \\\"净增:\\\", add-del}\""
	yesterday = "!git log --since=\"yesterday 00:00\" --until=\"today 00:00\" --numstat --pretty=\"\" --no-merges | awk \"{add+=\\$1; del+=\\$2} END {print \\\"新增:\\\", add, \\\"删除:\\\", del, \\\"净增:\\\", add-del}\""
	week = "!git log --since=\"$(date -v-monday +%Y-%m-%d) 00:00\" --numstat --pretty=\"\" --no-merges | awk \"{add+=\\$1; del+=\\$2} END {print \\\"新增:\\\", add, \\\"删除:\\\", del, \\\"净增:\\\", add-del}\""
	last7days = "!git log --since=\"7 days ago\" --numstat --pretty=\"\" --no-merges | awk \"{add+=\\$1; del+=\\$2} END {print \\\"新增:\\\", add, \\\"删除:\\\", del, \\\"净增:\\\", add-del}\""
